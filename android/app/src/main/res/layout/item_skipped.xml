<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/uber_card"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Type badge + date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSkippedType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/uber_green"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:textStyle="bold"
                tools:text="Заказ" />

            <TextView
                android:id="@+id/tvSkippedDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="@color/uber_text_secondary"
                android:textSize="11sp"
                android:gravity="end"
                tools:text="24.07, 14:30" />
        </LinearLayout>

        <!-- Status -->
        <TextView
            android:id="@+id/tvSkippedStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="⏳ Ищет водителя" />

        <!-- Address → address -->
        <TextView
            android:id="@+id/tvSkippedRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/uber_text_primary"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="ул. Пушкина, д. 10 → ул. Ленина, д. 25" />

<!-- Client name + phone -->
        <TextView
            android:id="@+id/tvSkippedClient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/uber_text_secondary"
            android:textSize="12sp"
            tools:text="Иван Иванов · 📞 +7 999 123-45-67" />
        <TextView
            android:id="@+id/tvSkippedHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/uber_yellow"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="↩ Нажмите, чтобы взять в работу" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>