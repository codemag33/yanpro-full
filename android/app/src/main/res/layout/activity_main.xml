<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/uber_black">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_top_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="8dp">

        <LinearLayout
            android:id="@+id/chipOnline"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_online_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/onlineDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_offline_dot" />

            <TextView
                android:id="@+id/tvOnlineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/status_offline"
                android:textColor="@color/uber_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvEarnings"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="— ₽"
            android:textColor="@color/uber_green"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_search_pill" />

        <ImageButton
            android:id="@+id/btnHistory"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/history_btn"
            android:src="@drawable/ic_history"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:layout_marginStart="4dp"
            app:tint="@color/uber_text_secondary" />

        <ImageButton
            android:id="@+id/btnSkipped"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Пропущенные"
            android:src="@drawable/ic_history"
            android:scaleType="centerInside"
            android:padding="6dp"
            app:tint="@color/uber_text_secondary" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Меню"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="6dp"
            app:tint="@color/uber_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_sheet"
        android:animateLayoutChanges="true">

        <!-- Persistent drag handle (always visible at bottom when collapsed) -->
        <LinearLayout
            android:id="@+id/sheetHandle"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_bottom_sheet">

            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bg_drag_handle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Потяните вверх"
                android:textColor="@color/uber_text_hint"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- ═══ Request card content ═══ -->
        <LinearLayout
            android:id="@+id/requestCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/countdownBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:max="30000"
                android:progressDrawable="@drawable/bg_countdown_bar" />

            <TextView
                android:id="@+id/tvRequestBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_search_pill"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:textColor="@color/uber_black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:text="НОВЫЙ ЗАКАЗ"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRequestAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:textColor="@color/uber_black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_online_dot"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvRequestPassengerName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/uber_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="Пассажир" />

                <TextView
                    android:id="@+id/tvRequestTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/uber_yellow"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:text="30" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRequestPickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/uber_text_primary"
                android:textSize="14sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Адрес подачи" />

            <TextView
                android:id="@+id/tvRequestDest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/uber_text_secondary"
                android:textSize="13sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Куда ехать" />

            <TextView
                android:id="@+id/tvRequestRouteInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/uber_green"
                android:textSize="12sp"
                android:text="— км · — мин" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPassRequest"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Пропустить"
                    android:textColor="@color/uber_text_secondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnAcceptRequest"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="2"
                    android:backgroundTint="@color/uber_yellow"
                    android:text="Принять"
                    android:textColor="@color/uber_black"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═══ Active card content ═══ -->
        <LinearLayout
            android:id="@+id/activeCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvActiveAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:gravity="center"
                    android:textColor="@color/uber_black"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_online_dot" />

                <TextView
                    android:id="@+id/tvActivePassenger"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/uber_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:text="Пассажир" />

                <ImageButton
                    android:id="@+id/btnActiveChat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_history"
                    android:scaleType="centerInside"
                    android:padding="8dp"
                    android:contentDescription="Чат"
                    app:tint="@color/uber_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvActivePickup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/uber_text_primary"
                android:textSize="14sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Адрес подачи" />

            <TextView
                android:id="@+id/tvActiveDest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/uber_text_secondary"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Куда ехать" />

            <TextView
                android:id="@+id/tvActiveRouteInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/uber_green"
                android:textSize="12sp"
                android:text="— км · — мин" />

            <TextView
                android:id="@+id/tvActiveStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/uber_text_secondary"
                android:textSize="12sp"
                android:text="Статус" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnActiveCancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_cancel"
                    android:textColor="@color/uber_red"
                    android:textSize="13sp"
                    app:strokeColor="@color/uber_red" />

                <Button
                    android:id="@+id/btnActiveAction"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="2"
                    android:backgroundTint="@color/uber_green"
                    android:text="Начать поездку"
                    android:textColor="@color/uber_black"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/priceOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#88000000"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_bottom_sheet"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Стоимость поездки"
                android:textColor="@color/uber_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPriceSuggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/uber_text_secondary"
                android:textSize="14sp"
                android:text="Предлагаемая цена" />

            <EditText
                android:id="@+id/etPriceInput"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:inputType="numberDecimal"
                android:background="@drawable/bg_search_pill"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/uber_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPriceCancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Отмена"
                    android:textColor="@color/uber_text_secondary" />

                <Button
                    android:id="@+id/btnPriceConfirm"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/uber_green"
                    android:text="Завершить"
                    android:textColor="@color/uber_black"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="38dp"
        android:src="@drawable/ic_locate_me"
        app:backgroundTint="@color/uber_card"
        app:tint="@color/uber_text_primary"
        app:fabSize="normal"
        app:elevation="6dp" />

    <LinearLayout
        android:id="@+id/connBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="44dp"
        android:gravity="center"
        android:padding="4dp"
        android:background="#FF9800"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvConnStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/uber_black"
            android:textSize="11sp"
            android:textStyle="bold"
            android:text="⏳ Переподключение..." />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
